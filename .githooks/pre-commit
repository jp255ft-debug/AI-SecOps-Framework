#!/bin/bash
# Pre-commit hook - AI-SecOps-Framework
# Runs security checks before each commit
# Install: git config core.hooksPath .githooks
set -euo pipefail

echo "🔍 AI-SecOps-Framework Pre-commit Hook"
echo "========================================"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

FAILED=0

# Check for hardcoded secrets
echo ""
echo "[1/3] Checking for hardcoded secrets..."
if command -v trivy &> /dev/null; then
    trivy fs --scanners secret --quiet . 2>&1 || true
    echo -e "${GREEN}[OK]${NC} Secret scan complete"
else
    echo -e "${YELLOW}[SKIP]${NC} Trivy not installed"
fi

# Check for large files being committed
echo ""
echo "[2/3] Checking for large files..."
LARGE_FILES=$(git diff --cached --name-only -z | xargs -0 ls -l 2>/dev/null | awk '{if($5>1048576) print $9}' || true)
if [ -n "$LARGE_FILES" ]; then
    echo -e "${YELLOW}[WARN]${NC} Large files detected (>1MB):"
    echo "$LARGE_FILES"
fi

# Check for merge conflicts
echo ""
echo "[3/3] Checking for merge conflicts..."
CONFLICT_FILES=$(git diff --cached --name-only -z | xargs -0 grep -l "^<<<<<<< \|^=======$\|^>>>>>>> " 2>/dev/null || true)
if [ -n "$CONFLICT_FILES" ]; then
    echo -e "${RED}[FAIL]${NC} Merge conflict markers found in:"
    echo "$CONFLICT_FILES"
    FAILED=1
else
    echo -e "${GREEN}[OK]${NC} No merge conflicts found"
fi

echo ""
if [ $FAILED -eq 1 ]; then
    echo -e "${RED}❌ Pre-commit checks failed. Commit blocked.${NC}"
    exit 1
else
    echo -e "${GREEN}✅ All pre-commit checks passed.${NC}"
fi
